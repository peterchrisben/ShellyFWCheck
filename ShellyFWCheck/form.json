{
    "elements": [
        {
            "type": "Label",
            "name": "Overview",
            "caption": ""
        },
        {
            "type": "ExpansionPanel",
            "name": "PanelPassword",
            "caption": "Password",
            "expanded": false,
            "items": [
                {
                    "type": "PasswordTextBox",
                    "name": "MasterPassword",
                    "caption": "Master password (for all devices)",
                    "width": "360px"
                },
                {
                    "type": "Label",
                    "caption": "Applies to all devices without a tick at \"Own PW\". The user name is always \"admin\" on Shelly devices. Devices without password protection need nothing."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "PanelDevices",
            "caption": "Manage devices",
            "expanded": false,
            "items": [
                {
                    "type": "List",
                    "name": "Devices",
                    "caption": "",
                    "rowCount": 12,
                    "add": true,
                    "delete": true,
                    "loadValuesFromConfiguration": false,
                    "columns": [
                        {
                            "caption": "Active",
                            "name": "Active",
                            "width": "60px",
                            "add": true,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Name",
                            "name": "Name",
                            "width": "auto",
                            "add": "",
                            "save": false
                        },
                        {
                            "caption": "IP address",
                            "name": "Host",
                            "width": "140px",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "Own PW",
                            "name": "OwnPassword",
                            "width": "90px",
                            "add": false,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Password",
                            "name": "Password",
                            "width": "120px",
                            "add": "",
                            "edit": {
                                "type": "PasswordTextBox"
                            }
                        },
                        {
                            "caption": "Battery",
                            "name": "Battery",
                            "width": "80px",
                            "add": false,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Wake signal (battery)",
                            "name": "WakeVar",
                            "width": "200px",
                            "add": 0,
                            "edit": {
                                "type": "SelectVariable"
                            }
                        }
                    ],
                    "values": []
                },
                {
                    "type": "Label",
                    "caption": "Add by hand: press \"Add\" and enter the IP address. With a tick at \"Own PW\" the password of the row is used instead of the master password. Tick at \"Battery\": the device is mostly asleep and is then shown as \"Sleeping\" instead of as an error. Wake signal (battery devices only): a variable that is written whenever the device wakes up, e.g. the temperature from the Shelly module – the module then queries the device right away and starts a scheduled update. Whether a password is correct is shown in the overview below after \"Apply changes\"."
                },
                {
                    "type": "List",
                    "name": "ScanRanges",
                    "caption": "Search further address ranges (other networks, e.g. guest or IoT network)",
                    "rowCount": 4,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "From (first IP address)",
                            "name": "From",
                            "width": "220px",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "To (last IP address)",
                            "name": "To",
                            "width": "220px",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "Label",
                            "name": "Label",
                            "width": "auto",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "Symcon's own network is always searched address by address. Enter ranges here only for Shellys in a different network (e.g. guest or IoT network). Example: From 192.168.20.1, To 192.168.20.254. If \"To\" is left empty, the whole network of the address is searched. At most 1024 addresses per row. Searching only happens with the button \"Search devices on the network\"."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "PanelSettings",
            "caption": "Check, notification and display",
            "expanded": false,
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "CheckInterval",
                    "caption": "Check automatically every (hours)",
                    "minimum": 0,
                    "maximum": 720,
                    "width": "340px"
                },
                {
                    "type": "Label",
                    "caption": "0 = no automatic check."
                },
                {
                    "type": "SelectInstance",
                    "name": "NotifyVisu",
                    "caption": "Push message to visualization",
                    "width": "700px"
                },
                {
                    "type": "Label",
                    "caption": "For a new update a push message goes to this tile visualization. Empty = no message."
                },
                {
                    "type": "CheckBox",
                    "name": "ShowTable",
                    "caption": "Create the variable \"Overview\" (table for the visualization)"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "PanelUpdates",
            "caption": "Updates",
            "expanded": false,
            "items": [
                {
                    "type": "CheckBox",
                    "name": "ContinueUpdates",
                    "caption": "After an update started here, continue right away until the latest version is installed (follow-up updates)"
                },
                {
                    "type": "CheckBox",
                    "name": "VisuCommands",
                    "caption": "Enable control from the visualization (variable \"Command\": Check now / Start all updates)"
                },
                {
                    "type": "NumberSpinner",
                    "name": "UpdateGap",
                    "caption": "Pause between devices (seconds)",
                    "minimum": 5,
                    "maximum": 600,
                    "width": "440px"
                },
                {
                    "type": "Label",
                    "caption": "Applies when several devices are updated one after another."
                },
                {
                    "type": "Label",
                    "caption": "Updates are never begun on their own – only via the buttons below or by script. Once begun, the module completes an update."
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Button",
                    "caption": "Check now",
                    "onClick": "SFW_CheckAll($id);"
                },
                {
                    "type": "Button",
                    "caption": "Search devices on the network",
                    "onClick": "SFW_Discover($id);"
                },
                {
                    "type": "Button",
                    "caption": "Update selected",
                    "onClick": "$h = []; foreach ($Status as $r) { if ($r['Select']) { $h[] = $r['Host']; } } SFW_UpdateSelected($id, json_encode($h));",
                    "confirm": "Start updates for the devices ticked in the \"Select\" column? The devices will restart."
                },
                {
                    "type": "Button",
                    "caption": "Start all updates",
                    "onClick": "SFW_UpdateAll($id);",
                    "confirm": "Start updates one after another for all devices with an available update? The devices will restart."
                }
            ]
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Label",
                    "caption": "Auto update in the device for the selected ones:"
                },
                {
                    "type": "Button",
                    "caption": "Off",
                    "onClick": "$h = []; foreach ($Status as $r) { if ($r['Select']) { $h[] = $r['Host']; } } SFW_SetAutoUpdate($id, json_encode($h), 'off');",
                    "confirm": "Switch off automatic firmware updates in the selected devices? Existing update schedules in these devices will be removed."
                },
                {
                    "type": "Button",
                    "caption": "Stable (daily at midnight)",
                    "onClick": "$h = []; foreach ($Status as $r) { if ($r['Select']) { $h[] = $r['Host']; } } SFW_SetAutoUpdate($id, json_encode($h), 'stable');",
                    "confirm": "Switch on automatic firmware updates (stable version) in the selected devices? The devices will then check by themselves every day at midnight and restart when updating."
                },
                {
                    "type": "Button",
                    "caption": "Send test message",
                    "onClick": "IPS_RequestAction($id, 'TestNotify', '');"
                }
            ]
        },
        {
            "type": "Label",
            "name": "Result",
            "caption": ""
        },
        {
            "type": "List",
            "name": "Status",
            "caption": "Overview",
            "rowCount": 15,
            "add": false,
            "delete": false,
            "columns": [
                {
                    "caption": "Select",
                    "name": "Select",
                    "width": "70px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Name",
                    "name": "Name",
                    "width": "220px",
                    "add": ""
                },
                {
                    "caption": "IP address",
                    "name": "Host",
                    "width": "130px",
                    "add": "",
                    "onClick": "echo 'http://' . $Status['Host'];",
                    "link": true
                },
                {
                    "caption": "Model",
                    "name": "Model",
                    "width": "130px",
                    "add": ""
                },
                {
                    "caption": "Installed",
                    "name": "Installed",
                    "width": "95px",
                    "add": ""
                },
                {
                    "caption": "Available",
                    "name": "Available",
                    "width": "95px",
                    "add": ""
                },
                {
                    "caption": "Auto update",
                    "name": "Auto",
                    "width": "105px",
                    "add": ""
                },
                {
                    "caption": "Status",
                    "name": "State",
                    "width": "auto",
                    "add": ""
                }
            ],
            "values": [],
            "onEdit": "$h = []; foreach ($Status as $r) { if ($r['Select']) { $h[] = $r['Host']; } } IPS_RequestAction($id, 'Select', json_encode($h));"
        },
        {
            "type": "Label",
            "caption": "Tick the \"Select\" column, then press the matching button above. Scheduled battery devices (blue) keep their tick – unticking cancels the scheduled update right away. A click on the IP address opens the web interface of the device. Some updates run in several steps and then take a few minutes."
        },
        {
            "type": "ExpansionPanel",
            "name": "PanelHistory",
            "caption": "Update history",
            "expanded": false,
            "items": [
                {
                    "type": "List",
                    "name": "History",
                    "caption": "",
                    "rowCount": 10,
                    "add": false,
                    "delete": false,
                    "columns": [
                        {
                            "caption": "Time",
                            "name": "Time",
                            "width": "170px",
                            "add": ""
                        },
                        {
                            "caption": "Device",
                            "name": "Name",
                            "width": "auto",
                            "add": ""
                        },
                        {
                            "caption": "From",
                            "name": "From",
                            "width": "140px",
                            "add": ""
                        },
                        {
                            "caption": "To",
                            "name": "To",
                            "width": "140px",
                            "add": ""
                        },
                        {
                            "caption": "Triggered by",
                            "name": "By",
                            "width": "240px",
                            "add": ""
                        }
                    ],
                    "values": []
                },
                {
                    "type": "Label",
                    "caption": "The last 50 version changes, newest first. \"not via the module\" means: auto update of the device, web interface, app or Shelly itself."
                }
            ]
        },
        {
            "type": "Label",
            "name": "BuildInfo",
            "caption": ""
        }
    ],
    "status": []
}